# Copy this file to .env and paste your Firebase Web app keys.
# Firebase Console → Project settings → Your apps → Web app → SDK setup
#
# Storage bucket example for this project (no gs:// prefix):
#   world-of-mirror.firebasestorage.app
#
# After saving .env, restart Expo:
#   npx expo start --clear
#
# Optional (development only): demo login buttons without Firebase
# EXPO_PUBLIC_USE_MOCK_DATA=true
# Release APKs always require Firebase keys below and email/password sign-in.
#
# Optional: dedicated password for "Clear all business data" (primary admin only).
# If unset, the primary admin must enter their Firebase sign-in password to confirm.
# EXPO_PUBLIC_DATA_RESET_PASSWORD=

# Expo push (EAS project ID) — required for admin alerts when the app is closed.
# Create at https://expo.dev → your project → Project settings → Project ID
# EXPO_PUBLIC_EAS_PROJECT_ID=

EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=world-of-mirror.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=world-of-mirror
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=world-of-mirror.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=

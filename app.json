{
  "expo": {
    "name": "world-of-mirror",
    "slug": "world-of-mirror",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "supportsRTL": true,
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "package": "com.anonymous.worldofmirror"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "يستخدم التطبيق معرض الصور لإرفاق صور الاستديو والطلبات.",
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-media-library",
        {
          "photosPermission": "يستخدم التطبيق مكتبة الصور لحفظ صور الكتالوج مع الملاحظات على جهازك.",
          "savePhotosPermission": "يستخدم التطبيق مكتبة الصور لحفظ صور الكتالوج مع الملاحظات على جهازك."
        }
      ],
      "expo-asset",
      "expo-image",
      [
        "expo-notifications",
        {
          "color": "#6C4DFF",
          "defaultChannel": "confirmed-orders",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم التطبيق موقعك لتسجيل الحضور داخل موقع العمل ومشاركة موقعك مع الإدارة عند الحاجة."
        }
      ],
      "@react-native-community/datetimepicker"
    ]
  }
}
